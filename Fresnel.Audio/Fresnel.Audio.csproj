<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  
  <PropertyGroup Label="Metadata">
    <Title>Fresnel.Audio</Title>
    <Product>Fresnel.Audio</Product>
    <Version>0.1.0</Version>
    <Authors>zerocker</Authors>
    <Description>A small audio companion for Foster Framework</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/zrckr/Fresnel.Audio</RepositoryUrl>
  </PropertyGroup>
  
  <PropertyGroup Label="Packaging">
    <PackageId>Fresnel.Audio</PackageId>
    <PackageProjectUrl>https://github.com/zrckr/Fresnel.Audio</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageOutputPath>$(SolutionDir)artifacts/</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <NativeLibsDir>$(ProjectDir)Internal\Native\</NativeLibsDir>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'X64'">
    <IsX64>true</IsX64>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'Arm64'">
    <IsArm64>true</IsArm64>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <IsWindows>true</IsWindows>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <IsLinux>true</IsLinux>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <IsOSX>true</IsOSX>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(NativeLibsDir)win-x64\**" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $(IsWindows) == 'true') or '$(RuntimeIdentifier)' == 'win-x64'">PreserveNewest</CopyToOutputDirectory>
      <PackagePath>runtimes\win-x64\native</PackagePath>
      <Pack>True</Pack>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="$(NativeLibsDir)linux-x64\**" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $(IsLinux) == 'true' and $(IsX64) == 'true') or '$(RuntimeIdentifier)' == 'linux-x64'">PreserveNewest</CopyToOutputDirectory>
      <PackagePath>runtimes\linux-x64\native</PackagePath>
      <Pack>True</Pack>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="$(NativeLibsDir)linux-arm64\**" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $(IsLinux) == 'true' and $(IsArm64) == 'true') or '$(RuntimeIdentifier)' == 'linux-arm64'">PreserveNewest</CopyToOutputDirectory>
      <PackagePath>runtimes\linux-arm64\native</PackagePath>
      <Pack>True</Pack>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="$(NativeLibsDir)osx-x64\**" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $(IsOSX) == 'true' and $(IsX64) == 'true') or '$(RuntimeIdentifier)' == 'osx-x64'">PreserveNewest</CopyToOutputDirectory>
      <PackagePath>runtimes\osx-x64\native</PackagePath>
      <Pack>True</Pack>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="$(NativeLibsDir)osx-arm64\**" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $(IsOSX) == 'true' and $(IsArm64) == 'true') or '$(RuntimeIdentifier)' == 'osx-arm64'">PreserveNewest</CopyToOutputDirectory>
      <PackagePath>runtimes\osx-arm64\native</PackagePath>
      <Pack>True</Pack>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FosterFramework" Version="0.4.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" Link="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
    <None Include="Effects\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="Effects\LGPL-2.0-or-later.txt" Pack="true" PackagePath="licenses" />
  </ItemGroup>

</Project>
